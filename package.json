{
  "name": "html-basico",
  "version": "1.0.3-crm.4",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:dmg": "electron-builder --mac dmg",
    "dist:zip": "electron-builder --mac zip",
    "dist:win": "electron-builder --win",
    "dist:review": "electron-builder --publish never",
    "check:source": "node scripts/check-package.cjs"
  },
  "keywords": [],
  "author": "Nexora Vision Pro",
  "license": "ISC",
  "description": "CorePoint App",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nexoravisionpro.corepoint",
    "productName": "CorePoint",
    "publish": [
      {
        "provider": "github",
        "owner": "nexoravisionpro",
        "repo": "app-electron"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "CorePoint-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "Facture01.html",
      "package.json",
      "preload.cjs",
      "business-pdf.cjs",
      "business-math.js",
      "operations.js",
      "operations.css",
      "fonts/*",
      "management.js",
      "management.css"
    ],
    "dmg": {
      "sign": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "pdfkit": "0.18.0"
  }
}
